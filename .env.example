# Copy this file to .env and fill in ONE of the options below.
# app.py loads .env automatically (python-dotenv) and also reads
# Streamlit Cloud st.secrets if deployed there.

# --- Option A: any OpenAI-compatible endpoint (Groq, Gemini, Ollama, etc.) ---
# Groq (free tier, no credit card): https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier): https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-1.5-flash

# Ollama (free, local, offline): https://ollama.com  ->  ollama pull llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=llama3.1:8b

# --- Option B: Anthropic Claude directly (paid) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# If neither is set, use "extractive" answer mode in the sidebar instead —
# retrieval still works, the app just returns the raw ranked passages.
